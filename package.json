{
  "name": "medusajs-documents-plugin",
  "version": "1.1.15",
  "description": "Comprehensive document generation and management module for Medusa v2 with Zoho Books integration, PDFKit fallback, QR codes, shortlinks, multi-channel notifications and unified admin hub.",
  "author": "Urban Device Care <info@urbandevicecare.co.uk>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbandevicecare/medusajs-documents-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/urbandevicecare/medusajs-documents-plugin/issues"
  },
  "homepage": "https://github.com/urbandevicecare/medusajs-documents-plugin#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".medusa/server",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./.medusa/server/src/index.js",
  "exports": {
    ".": "./.medusa/server/src/index.js",
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-documents",
    "medusa-documents-v2",
    "zoho-books",
    "pdfkit",
    "invoices"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:dev",
    "test": "npx tsx --test tests/run-all-tests.ts",
    "prepack": "medusa plugin:build"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.17.2",
    "@medusajs/cli": "2.17.2",
    "@medusajs/framework": "2.17.2",
    "@medusajs/icons": "2.17.2",
    "@medusajs/medusa": "2.17.2",
    "@medusajs/ui": "4.1.8",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.17.2",
    "@medusajs/framework": "2.17.2",
    "@medusajs/icons": "2.17.2",
    "@medusajs/ui": "4.1.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.18.0"
}
